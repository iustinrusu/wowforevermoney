#!/bin/sh
# On every push to GitHub: rebuild the starter price history (data/market_seed.json.gz) and replace the branch
# `market-data` with a single commit holding only that file, so new installs get fresh Market charts and old copies
# never pile up in the repository. Only where the price history exists (the app author's PC); never blocks a push.
# Enabled per clone with: git config core.hooksPath .githooks
[ -n "$WFM_SEED_PUSH" ] && exit 0                 # the push below runs this hook again: skip it
[ -f data/history.db ] || exit 0
PY="${LOCALAPPDATA}/Programs/Python/Python313/python.exe"
[ -x "$PY" ] || PY=$(command -v python3 || command -v python) || exit 0
"$PY" -m wfm.history seed >/dev/null 2>&1 || exit 0
BLOB=$(git hash-object -w data/market_seed.json.gz) || exit 0
TREE=$(printf '100644 blob %s\tmarket_seed.json.gz\n' "$BLOB" | git mktree) || exit 0
COMMIT=$(git commit-tree "$TREE" -m "Starter price history, $(date -u +%Y-%m-%d)") || exit 0
WFM_SEED_PUSH=1 git push --quiet --force "$1" "$COMMIT:refs/heads/market-data" || echo "market-data: not pushed"
exit 0
